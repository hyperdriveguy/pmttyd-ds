.fvec transform[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outpos position
.out outtc texcoord0
.out outcolor color
.alias position v0
.alias texcoord v1
.alias color v2
.proc main
    mov r0.xyz, position
    mov r0.w, constants.y
    dp4 outpos.x, transform[0], r0
    dp4 outpos.y, transform[1], r0
    dp4 outpos.z, transform[2], r0
    dp4 outpos.w, transform[3], r0
    mov outtc, texcoord
    mov outcolor, color
    end
.end
